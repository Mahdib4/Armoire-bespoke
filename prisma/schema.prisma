// Armoire Bespoke — data model.
// Database: Neon (PostgreSQL). DATABASE_URL is the pooled connection string
// (runtime); DIRECT_URL is the direct/non-pooled string (used by prisma db push
// / migrations). Both are set in .env (local) and in Vercel's env settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Key/value store for global site content (logo, slogan, hero video, brand name...).
model SiteSetting {
  key   String @id
  value String
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Category {
  id                String               @id @default(cuid())
  slug              String               @unique
  name              String
  order             Int                  @default(0)
  active            Boolean              @default(true)
  tagline           String?
  description       String?
  bannerType        String               @default("image") // image | video
  bannerUrl         String?
  posterUrl         String?
  sizeChartUrl      String? // shown on Ready-Made product pages
  products          Product[]
  measurementFields MeasurementField[]
  optionGroups      CustomizationGroup[] // bespoke options scoped to this collection
  subCategories     SubCategory[] // e.g. Blazer → Tuxedo, Suit Set, Nehru
  createdAt         DateTime             @default(now())
}

/// A sub-collection inside a category (Blazer → Tuxedo / Suit Set / Nehru).
/// Purely for organising and filtering the catalogue: every product still
/// belongs to its category, and may optionally sit in one of its sub-categories.
model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  order      Int       @default(0)
  active     Boolean   @default(true)
  products   Product[]
  createdAt  DateTime  @default(now())

  @@unique([categoryId, slug])
}

model Product {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  name            String
  categoryId      String
  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategoryId   String?
  subCategory     SubCategory?           @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  type            String                 @default("CUSTOM") // CUSTOM (Tailor Made) | READYMADE (Ready Made)
  priceTk         Int                    @default(0)
  tailoringCharge Int                    @default(0) // Tailor Made only
  description     String?
  specs           String? // JSON string: [{label,value}]
  fabric          String?
  colors          String? // JSON string of colour names (Ready Made)
  sizeOptions     String? // JSON string: [{label,stock}] (Ready Made sizes)
  outOfStock      Boolean                @default(false)
  order           Int                    @default(0)
  active          Boolean                @default(true)
  featured        Boolean                @default(false)
  sizeChartUrl    String?
  images          ProductImage[]
  customizations  ProductCustomization[]
  orderItems      OrderItem[]
  campaigns       CampaignProduct[]
  createdAt       DateTime               @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)
  featured  Boolean @default(false)
}

/// A configurable dimension of a bespoke garment (lapel, collar, cuff, pocket, vent, fabric).
/// Fully admin-managed: groups and their choices are created and edited from
/// Admin → Bespoke Options. A group can be scoped to one category (blazer
/// fabrics differ from shirt fabrics) or left global (categoryId = null).
model CustomizationGroup {
  id           String                 @id @default(cuid())
  kind         String // lapel | collar | cuff | pocket | vent | fabric | <admin-defined>
  name         String
  categoryId   String? // null = available to every category
  category     Category?              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  referenceUrl String?
  order        Int                    @default(0)
  choices      CustomizationChoice[]
  products     ProductCustomization[]
}

model CustomizationChoice {
  id      String             @id @default(cuid())
  groupId String
  group   CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label   String
  order   Int                @default(0)
}

/// Which customization groups apply to a given product (bespoke options shown on its page).
model ProductCustomization {
  id        String             @id @default(cuid())
  productId String
  groupId   String
  order     Int                @default(0)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
}

model MeasurementField {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String
  unit       String   @default("in")
  hint       String?
  order      Int      @default(0)
}

model Quote {
  id          String  @id @default(cuid())
  slot        String  @unique // manifesto | after-storytelling | after-blazer ...
  text        String
  attribution String?
  order       Int     @default(0)
}

model Section {
  key      String  @id // storytelling | lookbook | fabric | hero | craft
  title    String?
  subtitle String?
  body     String?
  config   String? // JSON
  order    Int     @default(0)
}

model Media {
  id        String   @id @default(cuid())
  url       String
  type      String   @default("image")
  alt       String?
  createdAt DateTime @default(now())
}

/// Customer testimonial shown in the "Customer's Words" section (homepage + product pages).
model Review {
  id        String   @id @default(cuid())
  author    String // customer name
  location  String? // optional, e.g. "Dhaka"
  rating    Int      @default(5) // 1–5
  text      String // the review / experience
  photos    String? // JSON array of image URLs
  featured  Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id           String      @id @default(cuid())
  publicId     String      @unique
  customerName String
  email        String
  phone        String
  address      String?
  city         String?
  appointment  String? // Home Visit | Office Appointment | Virtual Consultation
  note         String?
  subtotalTk   Int         @default(0) // items only, before discount and delivery
  couponCode   String? // coupon applied, if any
  discountTk   Int         @default(0) // coupon discount taken off the subtotal
  deliveryZone String? // inside-dhaka | outside-dhaka
  deliveryTk   Int         @default(0) // delivery charge for the chosen zone
  status       String      @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  items        OrderItem[]
  createdAt    DateTime    @default(now())
}

/// Contact / appointment enquiries submitted from the site (admin follow-up).
model Enquiry {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  subject     String?
  message     String?
  type        String   @default("contact") // contact | appointment
  appointment String? // Home Visit | Office Appointment | Virtual Consultation
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// Web Push subscriptions for admin browser notifications (new orders / enquiries).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  productName  String
  type         String
  priceTk      Int      @default(0)
  qty          Int      @default(1)
  selections   String? // JSON string of chosen customizations
  measurements String? // JSON string of measurements
}

/// A promotional campaign: a curated set of products from any collection shown
/// on its own landing page (a clean destination for Meta / Google ads), with an
/// optional discount, an optional poster shown once after the intro animation,
/// and optional discount labels on the product cards.
model Campaign {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String // internal name, e.g. "Eid 2026"
  headline      String? // big title shown on the campaign page / section
  subhead       String?
  description   String?
  /// none | percent | fixed — the default discount for every product in it.
  discountType  String            @default("none")
  discountValue Int               @default(0)
  /// Text on the corner label, e.g. "20% OFF". Blank = generated from the discount.
  badgeText     String?
  showBadges    Boolean           @default(true) // corner labels on the product cards
  accent        String? // hex accent colour for the campaign's styling
  bannerType    String            @default("image") // image | video
  bannerUrl     String?
  posterUrl     String? // banner poster frame / social share image
  ctaLabel      String?
  ctaHref       String?
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean           @default(false)
  showOnHome    Boolean           @default(true) // show the section on the homepage
  /// Poster shown once per visit, after the intro animation.
  popupShow     Boolean           @default(false)
  popupImage    String?
  popupTitle    String?
  popupBody     String?
  popupCta      String?
  popupHref     String?
  order         Int               @default(0)
  items         CampaignProduct[]
  createdAt     DateTime          @default(now())
}

/// A product placed in a campaign, with an optional discount of its own and
/// its own say over whether the corner label shows.
model CampaignProduct {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// null = use the campaign's discount.
  discountType  String?
  discountValue Int?
  badgeText     String?
  showBadge     Boolean  @default(true)
  order         Int      @default(0)

  @@unique([campaignId, productId])
}

/// A discount code entered at checkout. Every rule here is re-checked on the
/// server when the order is placed, so a code can never be abused from the client.
model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique // stored uppercase
  description   String?
  type          String             @default("percent") // percent | fixed
  value         Int                @default(0) // percent (1–100) or Tk off
  minSubtotalTk Int                @default(0) // minimum order value before it applies
  maxDiscountTk Int                @default(0) // cap for percentage codes; 0 = no cap
  appliesTo     String             @default("all") // all | READYMADE | CUSTOM
  categoryIds   String? // JSON array of category ids; empty/null = every collection
  productIds    String? // JSON array of product ids, for a code tied to specific pieces
  startsAt      DateTime?
  expiresAt     DateTime?
  usageLimit    Int                @default(0) // total redemptions allowed; 0 = unlimited
  perEmailLimit Int                @default(0) // per customer; 0 = unlimited
  usedCount     Int                @default(0)
  active        Boolean            @default(true)
  redemptions   CouponRedemption[]
  createdAt     DateTime           @default(now())
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  email     String
  orderId   String?
  amountTk  Int      @default(0)
  createdAt DateTime @default(now())
}
